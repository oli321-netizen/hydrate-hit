NEXT_PUBLIC_CUSTOM_DOMAIN=getfluxhit.com
NEXT_PUBLIC_SITE_URL=https://getfluxhit.com

# Railway: set this on the WEB service, then redeploy.
# DATABASE_URL=${{Postgres.DATABASE_URL}}

# JSONL path when DATABASE_URL is empty
# WAITLIST_PATH=data/waitlist.jsonl

# CSV export: GET /api/waitlist/export  Authorization: Bearer …
WAITLIST_EXPORT_SECRET=change-me

# Optional second copy to Formspree/Getform
# WAITLIST_FORWARD_ENDPOINT=https://formspree.io/f/xxxxxxxx
# NEXT_PUBLIC_WAITLIST_ENDPOINT=
# NEXT_PUBLIC_FORMSPREE_ID=
# NEXT_PUBLIC_GETFORM_ID=

# Site-wide maintenance bar (Railway: set on the web service, then restart/redeploy)
# MAINTENANCE_BANNER=1
# MAINTENANCE_ETA=about 15 minutes
# MAINTENANCE_MESSAGE=We're updating the site — back in about 15 minutes.
# MAINTENANCE_LOCKDOWN=1
