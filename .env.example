NEXT_PUBLIC_CUSTOM_DOMAIN=hydrationhit.com
NEXT_PUBLIC_SITE_URL=https://hydrationhit.com

# Railway Postgres plugin. If unset, emails go to WAITLIST_PATH (JSONL).
# DATABASE_URL=postgres://user:pass@host:5432/railway

# JSONL path when DATABASE_URL is empty
# WAITLIST_PATH=data/waitlist.jsonl

# CSV export: GET /api/waitlist/export  Authorization: Bearer …
WAITLIST_EXPORT_SECRET=change-me

# Optional second copy to Formspree/Getform
# WAITLIST_FORWARD_ENDPOINT=https://formspree.io/f/xxxxxxxx
# NEXT_PUBLIC_WAITLIST_ENDPOINT=
# NEXT_PUBLIC_FORMSPREE_ID=
# NEXT_PUBLIC_GETFORM_ID=
